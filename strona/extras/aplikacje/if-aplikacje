#!/usr/bin/env python3
# if-aplikacje — zakładanie aplikacji z Instalatora strony startowej (Zaplecze → Aplikacje → Instalator).
#
# Strona (kontener) nie widzi folderu app-data ani nie powinna zakładać folderów jako root.
# Dlatego robi to serwer: strona zostawia w swoim folderze config/ „karteczkę”
# aplikacje-zlecenie.json, zadanie systemd if-aplikacje.path ją zauważa i uruchamia ten skrypt.
#
# Pliki w folderze config strony:
#   aplikacje-zlecenie.json ← strona: {"akcja": "zaloz", "nazwa": "...", "compose": "...", "env": "..."}
#   aplikacje-stan.json     → serwer: wynik (trwa / gotowe / blad) i opis dla człowieka
#
# Akcja „zaloz”:
#   1. compose (i .env) zapisany w folderze tymczasowym i sprawdzony: docker compose config,
#   2. ~/docker/app/<nazwa> z compose.yaml (i .env) — właściciel: użytkownik, nie root,
#   3. foldery danych z compose, które leżą w ~/docker/app-data/<nazwa> — też użytkownika.
# Aplikacji nie uruchamia (to robi użytkownik w Dockge). Niczego nie nadpisuje.
#
# Akcja „aktualizuj” (Zaplecze → Aplikacje → Aktualizacje, przycisk „Aktualizuj”):
#   1. pobranie nowej wersji (aplikacja działa dalej; gdy się nie da — koniec, nic nie zmienione),
#   2. kopia tej aplikacji — przez zadanie kopii zapasowej (karteczka backup-zlecenie.json),
#   3. nowy compose (strona podaje go z nową wersją), stary odłożony do app/<stos>/backup/; up -d,
#   4. sprawdzenie, czy kontenery działają (i są „healthy”, jeśli mają healthcheck),
#   5. gdy nie działają: stary compose z powrotem, up -d i dane z kopii z punktu 1.
#
# Użycie (jako root, z if-aplikacje.service):
#   if-aplikacje obsluz /home/{user}/docker/app-data/if-startpage/config [kolejny folder config ...]
#   {user} — twoja nazwa użytkownika
#
import json
import os
import pwd
import re
import shutil
import subprocess
import sys
import tempfile
import time
from datetime import datetime

NAZWA_APLIKACJI = re.compile(r"^[a-z0-9][a-z0-9_-]{0,39}$")


class Blad(Exception):
    """Błąd z komunikatem dla człowieka (trafia na stronę).

    kod i zmienne — dla tłumaczeń (plan „Język”, Darek 11.11.2026): strona dobiera tekst po kodzie,
    polski tekst zostaje jako zapas."""

    def __init__(self, tekst, kod=None, **zmienne):
        super().__init__(tekst)
        self.kod = kod
        self.zmienne = zmienne


def teraz():
    return datetime.now().astimezone().isoformat(timespec="seconds")


def zapisz_json(sciezka, dane):
    """Zapis przez plik tymczasowy — strona nigdy nie widzi połowy pliku; właściciel jak folderu."""
    folder = os.path.dirname(sciezka)
    fd, tmp = tempfile.mkstemp(dir=folder, prefix=".tmp-", suffix=".json")
    with os.fdopen(fd, "w", encoding="utf-8") as f:
        json.dump(dane, f, ensure_ascii=False, indent=2)
    os.chmod(tmp, 0o644)
    st = os.stat(folder)
    try:
        os.chown(tmp, st.st_uid, st.st_gid)
    except OSError:
        pass
    os.replace(tmp, sciezka)


def czytaj_json(sciezka):
    try:
        with open(sciezka, encoding="utf-8") as f:
            return json.load(f)
    except (OSError, ValueError):
        return None


def wlasciciel(config):
    """Użytkownik serwera = właściciel folderu ~/docker/app (uid, gid, katalog domowy)."""
    st = os.stat(config)
    try:
        dom = pwd.getpwuid(st.st_uid).pw_dir
    except KeyError:
        dom = os.path.abspath(os.path.join(config, "..", "..", "..", ".."))
    app = os.path.join(dom, "docker", "app")
    st = os.stat(app if os.path.isdir(app) else config)
    return dom, st.st_uid, st.st_gid


def oddaj(sciezka, uid, gid):
    try:
        os.chown(sciezka, uid, gid)
    except OSError:
        pass


def zaloz(config, zlecenie):
    nazwa = str(zlecenie.get("nazwa") or "")
    if not NAZWA_APLIKACJI.match(nazwa):
        raise Blad("Niepoprawna nazwa aplikacji.", "bad_name")
    dom, uid, gid = wlasciciel(config)
    folder_app = os.path.join(dom, "docker", "app", nazwa)
    folder_danych = os.path.join(dom, "docker", "app-data", nazwa)
    if os.path.exists(folder_app):
        raise Blad(f"Aplikacja „{nazwa}” już jest na serwerze (folder app/{nazwa}). Niczego nie zmieniam.", "app_exists", nazwa=nazwa)

    compose = str(zlecenie.get("compose") or "")
    env = str(zlecenie.get("env") or "")
    tymczasowy = tempfile.mkdtemp(prefix=f".if-instalator-{nazwa}-", dir=os.path.join(dom, "docker", "app"))
    try:
        with open(os.path.join(tymczasowy, "compose.yaml"), "w", encoding="utf-8") as f:
            f.write(compose if compose.endswith("\n") else compose + "\n")
        if env.strip():
            with open(os.path.join(tymczasowy, ".env"), "w", encoding="utf-8") as f:
                f.write(env if env.endswith("\n") else env + "\n")

        # Sprawdzenie compose przez Dockera (nic nie uruchamia) i lista folderów z danymi.
        # Jako użytkownik, nie root: compose z „env_file” czy „extends” wskazującym np. /etc/shadow
        # nie przeczyta plików, do których użytkownik nie ma dostępu.
        polecenie = ["docker", "compose", "--project-name", nazwa, "--project-directory", tymczasowy,
                     "-f", os.path.join(tymczasowy, "compose.yaml"), "config", "--format", "json"]
        oddaj(tymczasowy, uid, gid)
        for plik in os.listdir(tymczasowy):
            oddaj(os.path.join(tymczasowy, plik), uid, gid)
        if os.geteuid() == 0:
            polecenie = ["runuser", "-u", pwd.getpwuid(uid).pw_name, "--"] + polecenie
        wynik = subprocess.run(polecenie, capture_output=True, text=True, timeout=60)
        if wynik.returncode != 0:
            opis = (wynik.stderr or wynik.stdout).strip().splitlines()
            ostatnia = (opis[-1] if opis else "nieznany błąd").replace(tymczasowy + os.sep, "")
            raise Blad("Docker nie przyjął compose: " + ostatnia, "compose_rejected", opis=ostatnia)
        konfiguracja = json.loads(wynik.stdout or "{}")
        foldery = set()
        for usluga in (konfiguracja.get("services") or {}).values():
            for wolumen in usluga.get("volumes") or []:
                zrodlo = wolumen.get("source") or ""
                if wolumen.get("type") == "bind" and (zrodlo == folder_danych or zrodlo.startswith(folder_danych + "/")):
                    foldery.add(zrodlo)

        # Foldery danych — tylko w app-data/<nazwa>, właściciel: użytkownik.
        os.makedirs(os.path.dirname(folder_danych), exist_ok=True)
        for folder in sorted({folder_danych, *foldery}):
            wzgledna = os.path.relpath(folder, folder_danych)
            czesci = [] if wzgledna == "." else wzgledna.split(os.sep)
            for i in range(len(czesci) + 1):
                kolejny = os.path.join(folder_danych, *czesci[:i])
                if not os.path.isdir(kolejny):
                    os.makedirs(kolejny)
                    oddaj(kolejny, uid, gid)

        for plik in os.listdir(tymczasowy):
            oddaj(os.path.join(tymczasowy, plik), uid, gid)
        if os.path.exists(os.path.join(tymczasowy, ".env")):
            os.chmod(os.path.join(tymczasowy, ".env"), 0o600)   # hasła — tylko dla użytkownika
        oddaj(tymczasowy, uid, gid)
        os.chmod(tymczasowy, 0o755)
        os.rename(tymczasowy, folder_app)
        return sorted(os.path.relpath(f, os.path.dirname(folder_danych)) for f in {folder_danych, *foldery})
    finally:
        if os.path.isdir(tymczasowy):
            shutil.rmtree(tymczasowy, ignore_errors=True)


# ─── Aktualizacja aplikacji ──────────────────────────────────────────────────

CZAS_KOPII_S = 3 * 3600          # kopia dużej aplikacji może trwać długo
CZAS_STARTU_S = 180              # tyle czekamy, aż nowa wersja wstanie
SPOKOJ_S = 20                    # kontener bez healthchecka: musi działać tyle sekund bez restartu


def stan_aktualizacji(config, **pola):
    # etap_kod / etap_zmienne — dla tłumaczeń; „etap” po polsku zostaje.
    plik = os.path.join(config, "aplikacje-stan.json")
    stan = czytaj_json(plik) or {}
    stan.update(pola)
    zapisz_json(plik, stan)


def zlecenie_kopii(config, zlecenie, opis, rodzaj):
    """Zleca pracę zadaniu kopii zapasowej (jak strona) i czeka na wynik; zwraca stan kopii."""
    plik = os.path.join(config, "backup-zlecenie.json")
    stan_plik = os.path.join(config, "backup-stan.json")
    if (czytaj_json(stan_plik) or {}).get("stan") == "trwa" or os.path.exists(plik):
        raise Blad("Trwa kopia zapasowa albo przywracanie — spróbuj po jej zakończeniu.", "backup_busy")
    start = time.time()
    zapisz_json(plik, {**zlecenie, "zlecono": teraz()})
    while time.time() - start < CZAS_KOPII_S:
        time.sleep(3)
        stan = czytaj_json(stan_plik) or {}
        if os.path.exists(plik):
            if time.time() - start > 60:
                os.remove(plik)
                raise Blad("Zadanie kopii zapasowej nie odpowiada (if-backup). W terminalu serwera: sudo if-server → Upgrade.", "backup_no_answer")
            continue
        if stan.get("stan") in ("gotowa", "blad") and stan.get("koniec") and \
                datetime.fromisoformat(stan["koniec"]).timestamp() >= start - 1:
            if stan["stan"] == "blad":
                raise Blad(f"{opis} nie udała się: {stan.get('komunikat') or 'nieznany błąd'}", f"{rodzaj}_failed", blad=stan.get("komunikat") or "")
            return stan
    raise Blad(f"{opis} trwa zbyt długo — przerwałem czekanie.", f"{rodzaj}_timeout")


def compose_ps(folder, plik):
    wynik = subprocess.run(["docker", "compose", "-f", plik, "ps", "--all", "--format", "json"],
                           cwd=folder, capture_output=True, text=True, timeout=60)
    tekst = wynik.stdout.strip()
    if not tekst:
        return []
    try:
        dane = json.loads(tekst)
        return dane if isinstance(dane, list) else [dane]
    except ValueError:
        return [json.loads(linia) for linia in tekst.splitlines() if linia.strip()]


def czy_dziala(folder, plik):
    """Czeka, aż wszystkie kontenery stosu działają; zwraca (True, "", {}) albo (False, opis, części opisu)."""
    start = time.time()
    spokojnie_od = None
    restart_od = None
    while time.time() - start < CZAS_STARTU_S:
        time.sleep(3)
        kontenery = compose_ps(folder, plik)
        if not kontenery:
            continue
        # Ciągłe restarty przez 30 s — aplikacja się wywraca, nie czekamy do końca.
        if any(k.get("State") == "restarting" for k in kontenery):
            restart_od = restart_od or time.time()
        else:
            restart_od = None
        zle = [k for k in kontenery if k.get("State") in ("exited", "dead") or k.get("Health") == "unhealthy"
               or (restart_od and time.time() - restart_od >= 30 and k.get("State") == "restarting")]
        if zle:
            k = zle[0]
            opis = f"{k.get('Name')}: {k.get('Status') or k.get('State')}"
            return False, opis, {"powod": opis}
        gotowe = all(k.get("State") == "running" and k.get("Health") in ("", None, "healthy") for k in kontenery)
        if gotowe:
            spokojnie_od = spokojnie_od or time.time()
            if time.time() - spokojnie_od >= SPOKOJ_S:
                return True, "", {}
        else:
            spokojnie_od = None
    kontenery = compose_ps(folder, plik)
    opis = ", ".join(f"{k.get('Name')}: {k.get('Status') or k.get('State')}" for k in kontenery) or "brak kontenerów"
    return False, f"aplikacja nie wstała w ciągu {CZAS_STARTU_S // 60} min ({opis})", \
        {"powod_kod": "start_timeout", "minuty": CZAS_STARTU_S // 60, "lista": opis if kontenery else ""}


def compose_up(folder, plik, *dodatkowe):
    wynik = subprocess.run(["docker", "compose", "-f", plik, *dodatkowe],
                           cwd=folder, capture_output=True, text=True, timeout=1800)
    if wynik.returncode != 0:
        opis = (wynik.stderr or wynik.stdout).strip().splitlines()
        raise Blad(opis[-1] if opis else "nieznany błąd Dockera", "docker_error", opis=opis[-1] if opis else "")


def aktualizuj(config, zlecenie):
    stos = str(zlecenie.get("stos") or "")
    if not NAZWA_APLIKACJI.match(stos):
        raise Blad("Niepoprawna nazwa aplikacji.", "bad_name")
    dom, uid, gid = wlasciciel(config)
    folder = os.path.join(dom, "docker", "app", stos)
    plik = next((os.path.join(folder, n) for n in ("compose.yaml", "compose.yml", "docker-compose.yaml", "docker-compose.yml")
                 if os.path.isfile(os.path.join(folder, n))), None)
    if not plik:
        raise Blad(f"Nie znaleziono pliku compose aplikacji „{stos}”.", "compose_missing", stos=stos)
    nowy = str(zlecenie.get("compose") or "")
    wersja = str(zlecenie.get("tag") or "")
    if "services" not in nowy:
        raise Blad("Strona nie podała nowego compose.", "no_new_compose")

    # 1. Pobranie nowej wersji z compose obok (aplikacja działa dalej). Nie da się — nic nie zmieniamy.
    stan_aktualizacji(config, etap=f"Pobieranie wersji {wersja}", etap_kod="pull", etap_zmienne={"wersja": wersja}, procent=10)
    nowy_plik = os.path.join(folder, ".if-compose-nowy.yaml")
    with open(nowy_plik, "w", encoding="utf-8") as f:
        f.write(nowy)
    try:
        compose_up(folder, nowy_plik, "pull")
    except Blad as e:
        raise Blad(f"Nie udało się pobrać nowej wersji ({e}). Nic nie zmieniłem — aplikacja działa jak dotąd.", "pull_failed", blad=str(e))
    finally:
        os.remove(nowy_plik)

    # 2. Kopia tej aplikacji (jeśli kopia zapasowa jest ustawiona i użytkownik jej nie wyłączył).
    kopia = None
    if zlecenie.get("kopia"):
        stan_aktualizacji(config, etap="Kopia zapasowa aplikacji", etap_kod="backup", etap_zmienne={}, procent=30)
        kopia = zlecenie_kopii(config, {"akcja": "kopia", "aplikacja": stos}, "Kopia aplikacji przed aktualizacją", "backup")
        kopia = (kopia.get("ostatnia") or {}).get("folder")

    # 2. Nowy compose; stary odłożony jak przy „Aktualizuj compose” (działa też „Cofnij”).
    stan_aktualizacji(config, etap="Zapis nowej wersji", etap_kod="save", etap_zmienne={}, procent=40)
    with open(plik, encoding="utf-8") as f:
        stary = f.read()
    kopie_compose = os.path.join(folder, "backup")
    os.makedirs(kopie_compose, exist_ok=True)
    oddaj(kopie_compose, uid, gid)
    odlozony = os.path.join(kopie_compose, "compose.yaml." + datetime.now().strftime("%Y%m%d-%H%M%S"))
    with open(odlozony, "w", encoding="utf-8") as f:
        f.write(stary)
    oddaj(odlozony, uid, gid)
    with open(plik, "w", encoding="utf-8") as f:
        f.write(nowy)

    def przywroc_stary(powod, czesci=None):
        czesci = czesci or {"powod": powod}
        stan_aktualizacji(config, etap="Powrót do poprzedniej wersji", etap_kod="rollback", etap_zmienne={}, procent=85)
        with open(plik, "w", encoding="utf-8") as f:
            f.write(stary)
        dane = ""
        if kopia:
            stan_aktualizacji(config, etap="Przywracanie danych z kopii", etap_kod="restore", etap_zmienne={}, procent=90)
            zlecenie_kopii(config, {"akcja": "przywroc", "kopia": kopia, "aplikacja": stos}, "Przywracanie danych", "restore")
            dane = f" i dane z kopii {kopia}"
        # Kontenery od nowa z poprzedniego compose (samo uruchomienie zostawiłoby nową wersję).
        compose_up(folder, plik, "up", "-d", "--force-recreate")
        dziala, opis, czesci_po = czy_dziala(folder, plik)
        if not dziala:
            raise Blad(f"Nowa wersja nie działa ({powod}), a po powrocie do poprzedniej wersji{dane} aplikacja też nie wstała ({opis}). Sprawdź ją w Dockge.",
                       "rollback_failed_backup" if kopia else "rollback_failed", kopia=kopia or "", **czesci,
                       po={k: v for k, v in czesci_po.items()})
        raise Blad(f"Nowa wersja nie działa ({powod}). Przywróciłem poprzednią wersję{dane} — aplikacja działa jak przed aktualizacją.",
                   "rolled_back_backup" if kopia else "rolled_back", kopia=kopia or "", **czesci)

    # 3. Uruchomienie nowej wersji.
    stan_aktualizacji(config, etap="Uruchamianie nowej wersji", etap_kod="start", etap_zmienne={}, procent=70)
    try:
        compose_up(folder, plik, "up", "-d")
    except Blad as e:
        przywroc_stary(str(e))

    # 4. Czy działa?
    stan_aktualizacji(config, etap="Sprawdzanie, czy aplikacja działa", etap_kod="check", etap_zmienne={}, procent=80)
    dziala, opis, czesci = czy_dziala(folder, plik)
    if not dziala:
        przywroc_stary(opis, czesci)
    return kopia


def obsluz(config):
    """Uruchamiane przez if-aplikacje.path, gdy strona zostawi karteczkę."""
    zlecenie_plik = os.path.join(config, "aplikacje-zlecenie.json")
    zlecenie = czytaj_json(zlecenie_plik) or {}
    try:
        os.remove(zlecenie_plik)
    except OSError:
        pass
    akcja = zlecenie.get("akcja")
    stan_plik = os.path.join(config, "aplikacje-stan.json")
    if akcja == "zaloz":
        nazwa = zlecenie.get("nazwa")
        try:
            foldery = zaloz(config, zlecenie)
            zapisz_json(stan_plik, {
                "stan": "gotowe", "nazwa": nazwa, "foldery": foldery, "czas": teraz(),
                "komunikat": f"Aplikacja „{nazwa}” jest przygotowana: compose w app/{nazwa}, dane w app-data/{nazwa}. Uruchom ją w Dockge („Deploy”).",
                "komunikat_kod": "app_ready", "zmienne": {"nazwa": nazwa}})
        except Blad as e:
            zapisz_json(stan_plik, {"stan": "blad", "nazwa": nazwa, "komunikat": str(e), "czas": teraz(),
                                    "komunikat_kod": e.kod, "zmienne": e.zmienne})
        except Exception as e:  # nieoczekiwany błąd — opis na stronę, szczegóły w dzienniku
            print(f"if-aplikacje: {e!r}", file=sys.stderr)
            zapisz_json(stan_plik, {"stan": "blad", "nazwa": nazwa, "czas": teraz(),
                                    "komunikat": f"Nieoczekiwany błąd: {e}. Szczegóły: journalctl -u if-aplikacje",
                                    "komunikat_kod": "unexpected", "zmienne": {"blad": str(e)}})
    elif akcja == "aktualizuj":
        stos = zlecenie.get("stos")
        stan_aktualizacji(config, stan="trwa", rodzaj="aktualizacja", nazwa=stos, procent=5,
                          etap="Przygotowanie", etap_kod="prepare", etap_zmienne={}, komunikat="", czas=teraz())
        try:
            kopia = aktualizuj(config, zlecenie)
            zapisz_json(stan_plik, {
                "stan": "gotowe", "rodzaj": "aktualizacja", "nazwa": stos, "procent": 100, "etap": "Gotowe", "etap_kod": "done", "czas": teraz(),
                "komunikat": f"Aplikacja „{stos}” działa w wersji {zlecenie.get('tag')}."
                             + (f" Kopia sprzed aktualizacji: {kopia}." if kopia else ""),
                "komunikat_kod": "updated_backup" if kopia else "updated",
                "zmienne": {"nazwa": stos, "wersja": zlecenie.get("tag") or "", "kopia": kopia or ""}})
        except Blad as e:
            zapisz_json(stan_plik, {"stan": "blad", "rodzaj": "aktualizacja", "nazwa": stos, "komunikat": str(e), "czas": teraz(),
                                    "komunikat_kod": e.kod, "zmienne": e.zmienne})
        except Exception as e:  # nieoczekiwany błąd — opis na stronę, szczegóły w dzienniku
            print(f"if-aplikacje: {e!r}", file=sys.stderr)
            zapisz_json(stan_plik, {"stan": "blad", "rodzaj": "aktualizacja", "nazwa": stos, "czas": teraz(),
                                    "komunikat": f"Nieoczekiwany błąd: {e}. Szczegóły: journalctl -u if-aplikacje",
                                    "komunikat_kod": "unexpected", "zmienne": {"blad": str(e)}})
    elif akcja:
        print(f"if-aplikacje: nieznana akcja „{akcja}”", file=sys.stderr)


def main():
    if len(sys.argv) < 3 or sys.argv[1] != "obsluz":
        print("Użycie: if-aplikacje obsluz /home/{user}/docker/app-data/if-startpage/config [...]", file=sys.stderr)
        return 2
    # Kilka folderów config (np. strona i jej wersja testowa) — każdy obsługiwany osobno.
    for config in sys.argv[2:]:
        if not os.path.isdir(config):
            print(f"if-aplikacje: pomijam {config} — nie ma takiego folderu", file=sys.stderr)
            continue
        obsluz(config)
    return 0


if __name__ == "__main__":
    sys.exit(main())
